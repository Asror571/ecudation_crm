# Application
NODE_ENV=development
PORT=3001

# MongoDB
# Use only URL-safe characters (A-Z a-z 0-9 - _ .) in the credentials, or
# percent-encode reserved characters (e.g. @ -> %40) inside MONGO_URI.
MONGO_ROOT_USERNAME=crm_admin
MONGO_ROOT_PASSWORD=change_this_password
MONGO_DB_NAME=education_crm
MONGO_URI=mongodb://crm_admin:change_this_password@localhost:27017/education_crm?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_BIND_ADDRESS=127.0.0.1

# JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
